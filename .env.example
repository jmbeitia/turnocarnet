# Perfil Digital de Rosario. CUIT: 11 dígitos, sin guiones
CUIT=20123456789
PASSWORD='tu_contraseña'

# Evolution API (vacío = notificación de macOS, para correr local)
EVOLUTION_URL=https://evolution.tu-dominio.com
EVOLUTION_INSTANCE=nombre_de_la_instancia
EVOLUTION_APIKEY=tu_apikey
# Tu número, formato internacional sin + (ej. 5493411234567)
WHATSAPP_TO=5493411234567

# Turnos que fuiste tomando, en orden y separados por coma (DD/MM/AAAA, hora opcional).
# El último es el actual: solo avisa de turnos anteriores. Vacío = cualquiera más temprano
MI_TURNO=25/11/2026, 04/11/2026 08:15

# Opcionales: hora del status diario y días para marcar ✅ un turno
# STATUS_HORA=9
# OBJETIVO_DIAS=30
